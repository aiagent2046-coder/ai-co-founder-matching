# ── Supabase (обязательно) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Приложение (обязательно) ───────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://syndimatch.online

# ── Anthropic / Claude (обязательно) ───────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
# Опционально: forward-прокси для вызовов Claude (tinyproxy на не-RU IP).
# Если не задан — прямой вызов, как раньше. Формат: http://host:port
ANTHROPIC_PROXY_URL=

# ── Telegram-бот (обязательно) ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ── Upstash Redis (обязательно) ────────────────────────────────────
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ── LiveKit (обязательно для видеозвонков) ─────────────────────────
# self-hosted LiveKit: серверные ключи + публичный WSS-URL клиента.
# ВАЖНО: указывай ПОРТ signaling-WSS явно. В нашем деплое signaling на :8443
# (порт 443 занят TURN/TLS). Без порта клиент пойдёт на :443 (TURN, не signaling)
# и подключение не установится. Значение LIVEKIT_URL (сервер) = этому же URL.
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://livekit.example.com:8443
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.example.com:8443

# ── GitHub OAuth (обязательно для привязки GitHub-аккаунтов) ───────
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret
# Ключ шифрования GitHub-токенов в БД (AES-256-GCM). Ровно 64 hex-символа
# (32 байта). Сгенерировать: openssl rand -hex 32
TOKEN_ENC_KEY=your_64_hex_char_key

# ── Replicate (обязательно для генерации аватаров/essence) ─────────
REPLICATE_API_KEY=your_replicate_api_key

# ── Аналитика PostHog (опционально) ────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Фича-флаги (опционально; 'true' включает, иначе выключено) ──────
BEHAVIORAL_MATCH_ENABLED=false
PSYCHO_V2_ENABLED=false
